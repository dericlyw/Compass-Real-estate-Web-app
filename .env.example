# Optional. Without it, the Copywriter agent uses the approved house copy library only.
ANTHROPIC_API_KEY=
# Hosted pilot: Supabase storage (apply supabase/migrations/0002_app_state.sql first).
# Without these the app stores data in .data/store.json (local only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Hosted pilot: shared passcode for the operator app (landing pages stay public).
ACCESS_CODE=
# Landing-page "TEST VERSION" banner; set to off only for a real launch.
NEXT_PUBLIC_TEST_MODE=on
# Public site URL used when building UTM landing-page links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
