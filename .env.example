# Optional. Without it, the Copywriter agent uses the approved house copy library only,
# and the Content Engine shows the copy-and-paste prompts instead of calling Claude.
ANTHROPIC_API_KEY=

# Storage. Without Supabase the app uses a local JSON file in .data/ (fine for one machine).
# For a hosted test (e.g. Vercel) set both, and run supabase/migrations/0002_workspace_store.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: separate workspaces in one database (e.g. "tkb-test", "compass-test").
PROPVID_WORKSPACE=default

# Test environment gate. When set, every page needs this shared code and nothing is indexed.
PROPVID_ACCESS_CODE=

# Public site URL used when building UTM landing-page links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
